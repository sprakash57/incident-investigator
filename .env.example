# Copy to .env and fill in what you use. .env is git-ignored.

# --- LLM -------------------------------------------------------------------
# Any PydanticAI model string: "<provider>:<model>", e.g.
#   anthropic:claude-sonnet-5-5
#   openai:<model-name>
#   bedrock:<model-id>
#   ollama:<model-name>
INVESTIGATOR_MODEL=

# Provider keys are read directly by the provider SDKs. Set only the one(s) you use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Amazon Bedrock: either a Bedrock API key, or normal AWS credentials (profile/env/role).
# Two ways to reach a Bedrock model:
#   bedrock:<model-id>         Converse API (model id or cross-region inference profile id)
#   bedrock-mantle:<model-id>  Bedrock's OpenAI-compatible endpoint; needs a Bedrock API key.
#                              Serves open models such as moonshotai.kimi-k2.5. List yours with:
#   curl https://bedrock-mantle.$AWS_DEFAULT_REGION.api.aws/v1/models \
#        -H "Authorization: Bearer $AWS_BEARER_TOKEN_BEDROCK"
AWS_BEARER_TOKEN_BEDROCK=
AWS_DEFAULT_REGION=

# --- Telemetry backend -----------------------------------------------------
# Where logs, metrics, topology and change events come from.
# Available: sqlite (synthetic demo). Planned: cloudwatch, loki, opensearch.
INVESTIGATOR_BACKEND=sqlite
INVESTIGATOR_SQLITE_PATH=data/demo.db

# --- Web search ------------------------------------------------------------
# duckduckgo (no key) | tavily (needs TAVILY_API_KEY) | none
INVESTIGATOR_SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=

# --- Python analysis sandbox -----------------------------------------------
# subprocess (default, guards against accidents) | docker (no network, read-only FS)
INVESTIGATOR_SANDBOX=subprocess

# --- Run limits & output ---------------------------------------------------
INVESTIGATOR_MAX_TOOL_CALLS=25
# Per-response output cap. Leave empty for the provider default; thinking models (e.g. Kimi)
# spend part of it on reasoning, so set it to the model's maximum if responses get cut off.
INVESTIGATOR_MAX_OUTPUT_TOKENS=
INVESTIGATOR_RUNS_DIR=runs
